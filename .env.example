# Скопируйте в .env (или задайте переменные в панели хостинга)

PORT=3000

# Первый запуск: создаётся администратор. Если ADMIN_PASSWORD не задан,
# пароль будет сгенерирован и показан в консоли один раз.
ADMIN_EMAIL=admin@novamedica.ru
ADMIN_PASSWORD=

# Где хранятся данные (контент, заявки, загруженные фото). На хостинге это должен быть постоянный диск.
DATA_DIR=./data

# Секрет для подписи сессий. Если не задан, создаётся сам и хранится в DATA_DIR.
SESSION_SECRET=

# За прокси/балансировщиком (Render, Railway, nginx): TRUST_PROXY=true
TRUST_PROXY=
# Публичный адрес сайта, для ссылки в письме о сбросе пароля
PUBLIC_URL=https://novamedica.ru

# Уведомления о заявках в Telegram (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Почта для восстановления пароля (необязательно; без неё ссылка печатается в консоль сервера)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
