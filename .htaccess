# Маршрутизация PHP-версии сайта (Apache, mod_rewrite)
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On

# Служебные папки и файлы закрыты
RewriteRule ^(php|server|test|deploy|data|node_modules|novamedica-data)(/|$) - [R=404,L]
RewriteRule ^(package(-lock)?\.json|README\.md|Dockerfile|app\.js|config(\.example)?\.php|router-dev\.php)$ - [R=404,L]

# Статика лендинга и админки
RewriteRule ^(css|js|assets)/(.*)$ public/$1/$2 [L]
RewriteRule ^admin/static/(.*)$ admin/$1 [L]

# Реально существующие файлы отдаём как есть
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(uploads|public|admin)/ - [L]

# Всё остальное обрабатывает index.php
RewriteRule ^(?!index\.php$) index.php [L]
</IfModule>

# Файлы настроек недоступны из браузера
<FilesMatch "^(config\.php|\.env.*)$">
Require all denied
</FilesMatch>
